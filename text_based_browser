def path_plus_file_name(cache_directory, url):
    # url_without_dotcom_split = url.split('.')[:-1]
    # file_name = "_".join(url_without_dotcom_split)
    file_name = url.split('.')[0]
    return cache_directory + '/' + file_name

def save_to_file(data, directory, url):
    file = open(path_plus_file_name(directory, url), 'w', encoding='utf-8')
    file.write(data)
    file.close()

def in_cache(cache_directory, url):
    return os.access(path_plus_file_name(cache_directory, url), os.F_OK)

def print_from_cache(cache_directory, url):

    file = open(path_plus_file_name(cache_directory, url), 'r', encoding='utf-8')
    print(file.read())
    file.close()

def print_from_web_plus_save(directory, url):
    response = requests.get('https://' + url)
    soup = BeautifulSoup(response.content, 'html.parser')
    output = []
    tags = ['p', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'a', 'ul', 'ol', 'li']
    counter = 0
    for tag in soup.find_all(tags):
        text = tag.get_text().strip()
        if not text:
            continue

        if tag.name == 'a':
            print(Fore.BLUE + text + Style.RESET_ALL)
        else:
            print(text)

        output.append(text)

    save_to_file('\n'.join(output), directory, url)

