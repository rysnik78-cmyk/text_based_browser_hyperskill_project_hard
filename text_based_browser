def main():
    my_stack = deque()
    # os.chdir('Text-Based Browser')
    args = sys.argv  # we get the list of arguments from command line
    if len(args) == 2:
        if not os.access(args[1], os.F_OK):
            os.mkdir(str(args[1]))
    while True:
        user_url = input()
        match user_url:
            case 'bloomberg.com':
                if in_cache(args[1], user_url):
                    print_from_cache(args[1], user_url)
                else:
                    print(bloomberg_com)
                    save_to_file(bloomberg_com, args[1], user_url)
                my_stack.append(user_url)
                continue
            case 'nytimes.com':
                if in_cache(args[1], user_url):
                    print_from_cache(args[1], user_url)
                else:
                    print(nytimes_com)
                    save_to_file(nytimes_com, args[1], user_url)
                my_stack.append(user_url)
                continue
            case x if '.' in x:
                if in_cache(args[1], user_url):
                    print_from_cache(args[1], user_url)
                else:
                    print_from_web_plus_save(args[1], user_url)
                my_stack.append(user_url)
                continue
            case 'back':
                if len(my_stack) < 2:
                    continue
                else:
                    my_stack.pop()
                    stack_url = my_stack.pop()
                    print_from_cache(args[1], stack_url)
                    my_stack.append(stack_url)
            case 'exit':
                break
            case _:
                print('Invalid URL')

if __name__ == '__main__':
    main()
