def save_to_file(data, directory, url):
    # print(name)
    # print(data)
    patch_plus_name = directory + '/' + url.split('.')[0]
    file = open(patch_plus_name, 'w', encoding='utf-8')
    file.write(data)
    file.close()

def in_cache(cache_directory, url):
    patch_plus_name = cache_directory + '/' + url.split('.')[0]
    return os.access(patch_plus_name, os.F_OK)

def print_from_cache(cache_directory, url):
    patch_plus_name = cache_directory + '/' + url.split('.')[0]
    file = open(patch_plus_name, 'r', encoding='utf-8')
    print(file.read())
    file.close()

def main():
    # os.chdir('Text-Based Browser')
    args = sys.argv  # we get the list of arguments from command line
    if len(args) == 2:
        if not os.access(args[1], os.F_OK):
            os.mkdir(str(args[1]))
    while True:
        user_url = input()
        match user_url:
            case 'bloomberg.com':
                if in_cache(args[1], user_url):
                    print_from_cache(args[1], user_url)
                else:
                    print(bloomberg_com)
                    save_to_file(bloomberg_com, args[1], user_url)
                continue
            case 'nytimes.com':
                print(nytimes_com)
                save_to_file(nytimes_com, args[1], user_url)
                continue
            case 'exit':
                break
            case _:
                print('Invalid URL')

if __name__ == '__main__':
    main()

